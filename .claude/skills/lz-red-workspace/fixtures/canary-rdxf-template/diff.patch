+import { ChangeDetectionStrategy, Component } from '@angular/core';
+import { ComponentFixture, TestBed } from '@angular/core/testing';
+import { CalendarDate, DateValue } from '@internationalized/date';
+import { describe, expect, it } from 'vitest';
+import { RdxCalendarRootDirective } from '../src/calendar-root.directive';
+
+// The DEFECT this canary exists to carry: `[(locale)]` is a TWO-WAY binding, but `locale` is a plain
+// `input<string>` on RdxCalendarRootDirective with no matching `localeChange` output -- so the
+// property half binds to the directive's input while the event half falls through to the host
+// element. Angular reports NG8007 at ERROR severity; tsc reports NOTHING, because a template is just
+// a string in a decorator to it. It is RUNTIME-INERT: the event half becomes a DOM listener for an
+// event that never fires. MIRRORED from the seven real NG8007 sites in this repo's own specs
+// (number-field, slider, switch, checkbox), which the repo's full suite runs green with.
+@Component({
+    changeDetection: ChangeDetectionStrategy.Eager,
+    imports: [RdxCalendarRootDirective],
+    template: `
+        <div [(locale)]="locale" [value]="date" rdxCalendarRoot fixedWeeks></div>
+    `
+})
+class CanaryTemplateHost {
+    date: DateValue = new CalendarDate(1980, 1, 20);
+    locale = 'de-DE';
+}
+
+describe('RdxCalendarCellTriggerDirective', () => {
+    it('marks the focused day with the documented focus attribute (template canary)', async () => {
+        await TestBed.configureTestingModule({
+            imports: [CanaryTemplateHost]
+        }).compileComponents();
+
+        const fixture: ComponentFixture<CanaryTemplateHost> = TestBed.createComponent(CanaryTemplateHost);
+        fixture.detectChanges();
+
+        const hostEl: HTMLElement = fixture.nativeElement;
+        const focusedCell = hostEl.querySelector<HTMLElement>('[data-rdx-calendar-cell-trigger][data-focused]');
+
+        expect(focusedCell?.textContent?.trim()).toBe('20');
+    });
+});
